APP_ENV=development
DATABASE_URL=sqlite:///./mavassist.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_MODE=keyword
# Hosted LLM for conversational RAG answers (OpenRouter). Keep the real key ONLY in backend/.env
# or your host's secret settings — never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=12
# Optional: use OpenAI directly instead of OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=
SIMILARITY_THRESHOLD=0.28
RATE_LIMIT=true
